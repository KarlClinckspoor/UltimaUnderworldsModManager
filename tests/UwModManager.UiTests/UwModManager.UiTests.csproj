<Project Sdk="Microsoft.NET.Sdk">
  <!-- xunit v3 (Avalonia.Headless.XUnit 12 is built on it): the screens rendered headless,
       driven through their view models. Screenshots go to bin/.../screenshots. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.3" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../UwModManager.Tests/Fixture.cs" Link="Fixture.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UwModManager.App/UwModManager.App.csproj" />
  </ItemGroup>
</Project>
